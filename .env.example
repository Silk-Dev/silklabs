# ──────────────────────────────────────────────
# SilkLabs — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Database ──────────────────────────────────
# PostgreSQL connection string (Docker Postgres on port 5444 by default)
DATABASE_URL="postgresql://postgres:postgres@localhost:5444/silklabs"

# ── Better Auth ───────────────────────────────
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET="change-me-to-a-random-hex-string"
# Base URL of your app (no trailing slash)
BETTER_AUTH_URL="http://localhost:3020"

# ── OAuth Providers ───────────────────────────
# Get credentials from each provider's developer console.
# Authorized redirect URIs (set in each provider's app):
#   http://localhost:3020/api/auth/callback/google
#   http://localhost:3020/api/auth/callback/github
#   http://localhost:3020/api/auth/callback/linkedin

# Google OAuth
# Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public env so client can show/enable the Google button
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# GitHub OAuth
# Settings: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Public env so client can show/enable the GitHub button
NEXT_PUBLIC_GITHUB_CLIENT_ID=

# LinkedIn OAuth
# Console: https://www.linkedin.com/developers/apps
# Required: Sign In with LinkedIn using OpenID Connect
# Redirect URL: http://localhost:3020/api/auth/callback/linkedin
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Public env so client can show/hide the LinkedIn button
NEXT_PUBLIC_LINKEDIN_CLIENT_ID=

# ── Analytics ─────────────────────────────────
# Google Analytics GA4 measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# ── Anthropic ─────────────────────────────────
# Required for venture concept generation (src/lib/concept.service.ts)
ANTHROPIC_API_KEY=

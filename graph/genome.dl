/* v0.4.0-alpha: Genome Engine — Soufflé Datalog Program
 *
 * This Soufflé program computes ONLY the transitive proximity (near)
 * relation, which is the one computation that's hard in Python.
 *
 * co_occurs, density, evolve_landing, and whitespace are computed
 * in Python (genome_pipeline.py) since they're simple aggregations.
 */

.decl co_occurs(a: symbol, b: symbol, n: number)
.input co_occurs(filename="co_occurs.facts")

/* Transitive proximity (bounded depth 4) */
.decl near(a: symbol, b: symbol, depth: number)
near(A, B, 1) :- co_occurs(A, B, _).
near(A, C, D+1) :-
    near(A, B, D),
    near(B, C, 1),
    D < 4,
    A != C.

.output near(filename="near.csv")

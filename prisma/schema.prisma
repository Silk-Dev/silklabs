
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectPhase {
  Ideation
  Building
  Launched
}

enum ApplicationStatus {
  Pending
  Accepted
  Rejected
}

enum UserRole {
  User
  Admin
}

enum ProductStatus {
  Draft
  Published
  Archived
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  emailVerified Boolean  @default(false)
  name          String?
  image         String?
  role          UserRole @default(User)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accounts     Account[]
  sessions     Session[]
  profile      Profile?
  portfolios   Portfolio[]
  projects     Project[]     @relation("ProjectOwner")
  teamMembers  TeamMember[]
  applications Application[]
  messages     Message[]
  notifications Notification[]
  bookmarks    Bookmark[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String    @default("")
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime
  updatedAt  DateTime

  @@map("verifications")
  @@index([identifier])
}

model Profile {
  id           String   @id @default(cuid())
  userId       String   @unique
  bio          String?
  timezone     String?
  avatarUrl    String?
  githubUrl    String?
  linkedinUrl  String?
  websiteUrl   String?
  businessName String?

  // Onboarding fields
  location           String?
  tldr               String?
  lookingFor         String?
  partnerships       String?
  commitment         String?
  motivation         String?
  experience         String?
  topSkill           String?
  skills             Json?
  isPublic           Boolean  @default(false)
  visibleRegions     String[]
  onboardingCompleted Boolean @default(false)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags     ProfileTag[]
  products Product[]

  @@map("profiles")
}

model Tag {
  id       String  @id @default(cuid())
  name     String  @unique
  category String? // e.g., "Language", "Framework", "Tool"

  profiles ProfileTag[]
  roles    RoleTag[]

  @@map("tags")
}

model ProfileTag {
  profileId String
  tagId     String

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([profileId, tagId])
  @@map("profile_tags")
}

model Portfolio {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  url         String?
  githubUrl   String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("portfolios")
}

model Project {
  id          String       @id @default(cuid())
  ownerId     String
  title       String
  tagline     String?
  description String?
  coverImage  String?
  phase       ProjectPhase @default(Ideation)
  discordLink String?
  repoLink    String?
  isPublic    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  owner       User         @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  roles       Role[]
  teamMembers TeamMember[]
  bookmarks   Bookmark[]

  @@map("projects")
}

model Role {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  description String?
  isFilled    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tags         RoleTag[]
  applications Application[]

  @@map("roles")
}

model RoleTag {
  roleId String
  tagId  String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([roleId, tagId])
  @@map("role_tags")
}

model Application {
  id        String            @id @default(cuid())
  userId    String
  roleId    String
  message   String?
  status    ApplicationStatus @default(Pending)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("applications")
}

model TeamMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String? // Custom title within the team, e.g. "Lead Developer"
  joinedAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("team_members")
}

model Message {
  id        String   @id @default(cuid())
  userId    String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("messages")
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // "new_project", "application", "team_invite", etc.
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
  @@index([userId, read])
  @@index([createdAt])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@map("bookmarks")
}

model Product {
  id          String        @id @default(cuid())
  ownerId     String
  title       String
  tagline     String?
  description String?
  price       Float?
  category    String?
  images      String[]
  status      ProductStatus @default(Draft)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  owner Profile @relation(fields: [ownerId], references: [userId], onDelete: Cascade)

  @@map("products")
  @@index([status])
  @@index([ownerId])
}
